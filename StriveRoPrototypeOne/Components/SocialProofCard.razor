@using StriveRoPrototypeOne.Models
@using MudBlazor

<MudCard Class="mx-auto" Style="max-width: 300px;">
    <MudCardMedia Image="@Entry.LogoUrl"  Height="140" />

    <MudCardContent>
        <MudText Typo="Typo.h6" Align="Align.Center">@Entry.Name</MudText>
        <MudText Typo="Typo.body2" Align="Align.Center" Class="italic text-gray-600">
            "@Entry.Testimonial"
        </MudText>
    </MudCardContent>

    <MudCardActions Class="justify-center">
        @for (int i = 0; i < Entry.Stars; i++)
        {
            <MudIcon Color="Color.Warning" Icon="@Icons.Material.Filled.Star" />
        }
        @for (int i = Entry.Stars; i < 5; i++)
        {
            <MudIcon Color="Color.Success" Icon="@Icons.Material.Filled.Star" />
        }
    </MudCardActions>
</MudCard>

@code {
    [Parameter]
    public SocialProofEntry Entry { get; set; }
}
