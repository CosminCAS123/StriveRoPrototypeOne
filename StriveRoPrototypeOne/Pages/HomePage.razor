@page "/"
@using MudBlazor
@using Models
@using Components

@inject HttpClient http

<div class="fullscreen-container">
    <MudContainer MaxWidth="MaxWidth.Large">
        <MudStack Spacing="3" AlignItems="AlignItems.Center" JustifyContent="Center">

            <div class="headline">
                <MudText Align="Align.Center" Typo="Typo.h2">
                    Crește. Evoluează. Reușește.
                </MudText>
            </div>

            <div class="subheadline">
                <MudText Typo="Typo.h5" Align="Align.Center">
                    Platforma care te ajută să devii cea mai bună versiune a ta.
                </MudText>
            </div>

            <div class="cta-button">
                <MudButton Style="color:white">
                    Începe ACUM.
                </MudButton>
            </div>
            <MudSpacer></MudSpacer>
            <div class="section-header">
                <MudText Typo="Typo.h4" Align="Align.Center">
                    Cum funcționează?
                </MudText>
            </div>
            <MudCarousel ItemsSource="@Steps"
                          SelectedIndex="0"
                         ShowArrows="@arrows"
                         ShowBullets="@bullets"
                         EnableSwipeGesture="@enableSwipe"
                         TransitionAutoCycle="true"
                         AutoCycleInterval="3000"
                         Style="width:100%; height:400px;">

                <ItemTemplate>
                    <MudCard Class="how-it-works-card" Style="height:100%;">
                        <MudCardContent Class="d-flex flex-row" Style="padding:0; height:100%;">
                            <MudCardMedia Image="@context.Image" Style="width:50%; height:100%; object-fit:cover;" />
                            <div style="width:50%; padding:2rem;">
                                <MudText Typo="Typo.h4">@context.Title</MudText>
                                <MudText Typo="Typo.body1">@context.Description</MudText>
                            </div>
                        </MudCardContent>
                    </MudCard>
                </ItemTemplate>

            </MudCarousel>



            <MudSpacer>

            </MudSpacer>

            <div class="section-header">
                <MudText Typo="Typo.h4" Align="Align.Center">
                    Clienți satisfăcuți
                </MudText>
            </div>
            <MudSpacer>

            </MudSpacer>
            @if(this.entry is not null)
            {
                <StriveRoPrototypeOne.Components.SocialProofCard Entry="this.entry">

                </StriveRoPrototypeOne.Components.SocialProofCard>
            }


        </MudStack>
    </MudContainer>
</div>

@code {
    private bool arrows = true;
    private bool bullets = true;
    private bool enableSwipe = true;
    

    private SocialProofEntry entry;
    private List<StepInfo> Steps = new();


    protected override async Task OnInitializedAsync()
    {
       
            var all_entries_json = await http.GetFromJsonAsync<List<SocialProofEntry>>("sample-data/socialProofData.json");
            this.Steps = await http.GetFromJsonAsync<List<StepInfo>>("sample-data/howItWorksData.json");
            this.entry = all_entries_json?.FirstOrDefault();
           
       
    }



 

   

}
