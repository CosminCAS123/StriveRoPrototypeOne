@page "/"
@using MudBlazor

<div class="fullscreen-container">
    <MudContainer MaxWidth="MaxWidth.Large">
        <MudStack Spacing="3" AlignItems="AlignItems.Center" JustifyContent="Center">

            <div class="headline">
                <MudText Align="Align.Center" Typo="Typo.h2">
                    Crește. Evoluează. Reușește.
                </MudText>
            </div>

            <div class="subheadline">
                <MudText Typo="Typo.h5" Align="Align.Center">
                    Platforma care te ajută să devii cea mai bună versiune a ta.
                </MudText>
            </div>

            <div class="cta-button">
                <MudButton Style="color:white">
                    Începe ACUM.
                </MudButton>
            </div>
            <MudSpacer></MudSpacer>
            <div class="section-header">
                <MudText Typo="Typo.h4" Align="Align.Center">
                    Cum funcționează?
                </MudText>
            </div>
            <MudCarousel ItemsSource="@Steps"
                         ShowArrows="@arrows"
                         ShowBullets="@bullets"
                         EnableSwipeGesture="@enableSwipe"
                         Style="width:100%; height:400px;">
                <ItemTemplate>
                    <MudCard Class="how-it-works-card" Style="height:100%;">
                        <MudCardContent Class="d-flex flex-row" Style="padding:0; height:100%;">
                            <MudCardMedia Image="@context.Image" style="width:50%; height:100%; object-fit:cover;" />
                            <div style="width:50%; padding:2rem;">
                                <MudText Typo="Typo.h4">@context.Title</MudText>
                                <MudText Typo="Typo.body1">@context.Description</MudText>
                            </div>
                        </MudCardContent>
                    </MudCard>
                </ItemTemplate>
            </MudCarousel>




            <MudSpacer>

            </MudSpacer>
        </MudStack>
    </MudContainer>
</div>

@code {
    private bool arrows = true;
    private bool bullets = true;
    private bool enableSwipe = true;

    private List<StepInfo> Steps = new()
    {
        new StepInfo
        {
            Title = "Înregistrează-te simplu",
            Description = "În mai puțin de un minut faci primul pas către transformarea ta personală. O decizie mică pentru rezultate mari.",
            Image = "images/card1img.jpg"
        },
        new StepInfo
        {
            Title = "Personalizează-ți obiectivele",
            Description = "Stabilește-ți clar prioritățile și permite platformei să te ghideze zilnic spre versiunea ta ideală. Progresul începe cu tine.",
            Image = "images/card2img.jpg"
        },
        new StepInfo
        {
            Title = "Vezi rezultate clare",
            Description = "Observă constant progresul făcut și simte motivația reușitei. Fiecare zi te aduce mai aproape de obiectivele tale.",
            Image = "images/card3img.jpg"
        }
    };

    public class StepInfo
    {
        public string Title { get; set; }
        public string Description { get; set; }
        public string Image { get; set; }
    }

}
